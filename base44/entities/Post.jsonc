{
  "name": "Post",
  "type": "object",
  "properties": {
    "author": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "url": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "reactions": {
      "type": "number",
      "default": 0
    },
    "comments": {
      "type": "number",
      "default": 0
    },
    "reposts": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "author",
    "date",
    "title"
  ]
}